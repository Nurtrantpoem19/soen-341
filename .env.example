DATABASE_URL=postgres://careerconnect:local_dev_only@localhost:5432/careerconnect
PORT=3000
# Optional comma-separated browser origins; localhost:5500 is always allowed.
CORS_ALLOWED_ORIGINS=
# Temporary local profile demo only; not real authentication.
DEMO_AUTH=true
# AI resume feedback (Sprint 3), Google Gemini free tier. Get a free key at https://aistudio.google.com/apikey
# Without a key the server still runs and the feature returns 503.
GEMINI_API_KEY=
# Optional model overrides; defaults are gemini-3.5-flash-lite, with gemini-3.8-flash as backup when it is busy.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL= 
